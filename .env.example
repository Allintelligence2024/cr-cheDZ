# Copier vers .env (racine) et remplir. Ne jamais committer le .env réel.

# ─── Application ────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=https://votre-domaine.dz

# ─── Base de données ────────────────────────────────────────
DATABASE_URL=postgresql://creche_app:CHANGEZ_CE_MOT_DE_PASSE_FORT@localhost:5432/creche_dev
POSTGRES_DB=creche_dev
POSTGRES_USER=creche_app
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_FORT

# ─── JWT (générer avec: openssl rand -base64 48) ────────────
JWT_SECRET=CHANGEZ_CE_SECRET_MINIMUM_48_CARACTERES
JWT_REFRESH_SECRET=CHANGEZ_CE_SECRET_REFRESH_MINIMUM_48_CARACTERES
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stockage objet ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=VOTRE_CLE_ACCES
S3_SECRET_KEY=VOTRE_CLE_SECRETE
S3_BUCKET=creche-media
S3_REGION=us-east-1
S3_URL_EXPIRY_SECONDS=3600

# ─── Notifications push ─────────────────────────────────────
FCM_SERVER_KEY=VOTRE_CLE_FCM_FIREBASE
APNS_KEY_ID=VOTRE_KEY_ID_APPLE
APNS_TEAM_ID=VOTRE_TEAM_ID_APPLE

# ─── SMS ────────────────────────────────────────────────────
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# ─── WhatsApp Business (notifications + OTP) ────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v19.0

# ─── Paiement ───────────────────────────────────────────────
PAYMENT_PROVIDER=none
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── H2k — collecte Prometheus de /api/v1/metrics (privilège limité) ────────
# Côté API : UNIQUEMENT la liste des digests SHA-256 des tokens autorisés au
# scrape (virgule = fenêtre de grâce pendant une rotation). Vide = collecte par
# token désactivée ; l'accès administrateur plateforme (H2j) reste le seul
# chemin, l'accès anonyme reste 401. Ne jamais coller le token brut ici.
METRICS_COLLECTOR_TOKEN_HASHES=
# Côté Prometheus : chemin HORS DÉPÔT du fichier contenant le token brut
# (authorization.credentials_file). Générer les deux avec :
#   node scripts/provision-metrics-collector.mjs --out-file /etc/creche/secrets/metrics-collector-token
METRICS_COLLECTOR_TOKEN_FILE=/run/secrets/metrics-collector-token

# ─── G5 — chiffrement au repos des secrets TOTP (MFA) ──────────────────────
# Clé AES-256-GCM qui protège users.totp_secret AU REPOS. 32 octets encodés :
# 64 caractères hexadécimaux, ou base64/base64url. Format de rotation :
# « courante,ancienne » — la première scelle, toutes déchiffrent ; retirer
# l'ancienne une fois les lignes rescellées à la courante (rescellage à l'usage).
# Absence = mode historique (stockage en clair) toléré en test/dev UNIQUEMENT ;
# en production, le démarrage de l'API est REFUSÉ sans clé valide.
# Générer : openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ─── Sécurité ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:4000,https://votre-domaine.dz

# Phase E2 : purges quotidiennes 02h Africa/Algiers, paiements chaque heure.
# Facturation mensuelle automatique INTERDITE (contrainte SQL), jobs manuels seuls.
WORKER_SCHEDULER_ENABLED=true
WORKER_SCHEDULER_POLL_MS=60000
# Export : limite d’exécution 2 min, attente 30 min (API réconcilie aussi à 30 min).
WORKER_EXPORT_TIMEOUT_MS=120000
WORKER_EXPORT_MAX_AGE_MS=1800000
