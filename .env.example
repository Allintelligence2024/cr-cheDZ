# Copier vers .env (racine) et remplir. Ne jamais committer le .env réel.

# ─── Application ────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_URL=https://votre-domaine.dz

# ─── Base de données ────────────────────────────────────────
DATABASE_URL=postgresql://creche_app:CHANGEZ_CE_MOT_DE_PASSE_FORT@localhost:5432/creche_dev
POSTGRES_DB=creche_dev
POSTGRES_USER=creche_app
POSTGRES_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_FORT

# ─── JWT (générer avec: openssl rand -base64 48) ────────────
JWT_SECRET=CHANGEZ_CE_SECRET_MINIMUM_48_CARACTERES
JWT_REFRESH_SECRET=CHANGEZ_CE_SECRET_REFRESH_MINIMUM_48_CARACTERES
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stockage objet ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=VOTRE_CLE_ACCES
S3_SECRET_KEY=VOTRE_CLE_SECRETE
S3_BUCKET=creche-media
S3_REGION=us-east-1
S3_URL_EXPIRY_SECONDS=3600

# ─── Notifications push ─────────────────────────────────────
FCM_SERVER_KEY=VOTRE_CLE_FCM_FIREBASE
APNS_KEY_ID=VOTRE_KEY_ID_APPLE
APNS_TEAM_ID=VOTRE_TEAM_ID_APPLE

# ─── SMS ────────────────────────────────────────────────────
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER_ID=

# ─── WhatsApp Business (notifications + OTP) ────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v19.0

# ─── Paiement ───────────────────────────────────────────────
PAYMENT_PROVIDER=none
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ─── Monitoring ─────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Sécurité ───────────────────────────────────────────────
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:4000,https://votre-domaine.dz
