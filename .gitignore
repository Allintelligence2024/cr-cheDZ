# Dependencies
node_modules/
.cache/
.pnpm-store/

# Builds
dist/
build/
# Rapports de couverture de tests (racine + apps/packages) — ATTENTION :
# un pattern `coverage/` non ancré ignorait aussi lib/features/coverage/ des apps
# Flutter (bug : coverage_page.dart n'a jamais été pushé — corrigé 2026-09-29).
/coverage/
apps/*/coverage/
packages/*/coverage/
*.tsbuildinfo

# Env & secrets
.env
.env.local
.env.*.local
# D1 : .env.prod est un fichier LOCAL d'exploitation (copié depuis
# .env.prod.example) — jamais versionné.
.env.prod

# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# Logs
logs/
*.log
npm-debug.log*

# Playwright (job e2e)
playwright-report/
test-results/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Backups locaux
*.sql.gz
backups/
tests/load/capacity-report.json

# P1-2 — signature Android : jamais de keystore ni de mots de passe dans Git
apps/*/android/key.properties
*.jks
*.keystore

# M1 — Firebase : configs d'apps (identifiants projet), jamais commités
google-services.json
GoogleService-Info.plist

# Dossier temporaire du test de libellés (supprimé automatiquement ; filet de sécurité)
packages/design-system/src/.tmp-label-test-*/
