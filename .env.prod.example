# ============================================================================
# .env.prod.example — Variables de production (copier vers .env et remplir)
# Chaque variable est réellement lue par le code (vérifié par grep).
# Les secrets sont à générer avec : openssl rand -hex 32
# ============================================================================

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=creche
POSTGRES_USER=creche_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG
# URL utilisée par l'API et le worker (rôle applicatif NOBYPASSRLS) :
DATABASE_URL=postgres://creche_app:CHANGE_ME_STRONG@postgres:5432/creche

# ── Authentification ────────────────────────────────────────────────────────
JWT_SECRET=openssl_rand_hex_32
# (facultatif, les refresh tokens sont hachés SHA-256 sans secret)
JWT_REFRESH_SECRET=openssl_rand_hex_32
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ── Stockage objets (MinIO / S3) ────────────────────────────────────────────
MINIO_ROOT_USER=minio_prod
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_prod
S3_SECRET_KEY=CHANGE_ME_STRONG
S3_BUCKET=creche-media
S3_REGION=us-east-1
S3_URL_EXPIRY_SECONDS=3600
# Backend de stockage des PDF : 'local' (répertoire) ou 's3' (MinIO/S3)
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=/tmp/creche-pdf

# ── Webhook de paiement ─────────────────────────────────────────────────────
PAYMENT_WEBHOOK_SECRET=openssl_rand_hex_32

# ── Push (FCM + APNs) ───────────────────────────────────────────────────────
# Contenu JSON du service account Firebase (une ligne, échappé) :
FIREBASE_SERVICE_ACCOUNT_JSON={ "type": "service_account", ... }
APNS_KEY_ID=KEY_ID_APPLE
APNS_TEAM_ID=TEAM_ID_APPLE
APNS_BUNDLE_ID=dz.creche.parent
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
APNS_PRODUCTION=false

# ── SMS (OTP) ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM=+213xxxxxxxx

# ── Email (DPO / violations ANPDP / invitations) ────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.dz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dpo@creche.dz
SMTP_PASS=CHANGE_ME
SMTP_FROM=dpo@creche.dz
SMTP_TO=dpo@creche.dz

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000
APP_URL=https://creche.dz
CORS_ORIGINS=https://creche.dz
# Désactiver le rate limiting applicatif : uniquement en test (jamais en prod)
RATE_LIMIT_DISABLED=false

# ── Rétention / jobs ────────────────────────────────────────────────────────
RETENTION_DAYS=1825

# ── Observabilité ───────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxxxxx@oXXXX.ingest.sentry.io/XXXX

# ── Déploiement ─────────────────────────────────────────────────────────────
DOMAIN=creche.dz
VERSION=staging
# Chiffrement des sauvegardes (scripts/backup.sh — GPG symétrique AES256)
BACKUP_PASSPHRASE=CHANGE_ME_STRONG
