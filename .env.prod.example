# ============================================================================
# .env.prod.example — Variables de production (copier vers .env et remplir)
# Chaque variable est réellement lue par le code (vérifié par grep).
# Les secrets sont à générer avec : openssl rand -hex 32
# ============================================================================

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_DB=creche
POSTGRES_USER=postgres # init administrateur uniquement
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_HEX_64
# Trois secrets DISTINCTS, générés séparément (openssl rand -hex 32).
# Hex recommandé pour éviter l'encodage URL ; sinon encoder les mots de passe
# dans les URLs, mais garder APP/MIGRATOR_DATABASE_PASSWORD bruts pour bootstrap.
APP_DATABASE_PASSWORD=CHANGE_ME_APP_HEX_64
MIGRATOR_DATABASE_PASSWORD=CHANGE_ME_MIGRATOR_HEX_64
MIGRATION_DATABASE_URL=postgres://creche_migrator:CHANGE_ME_MIGRATOR_HEX_64@postgres:5432/creche
# URL utilisée par l'API et le worker (rôle applicatif NOBYPASSRLS) :
DATABASE_URL=postgres://creche_app:CHANGE_ME_APP_HEX_64@postgres:5432/creche

# ── Authentification ────────────────────────────────────────────────────────
JWT_SECRET=openssl_rand_hex_32
# (facultatif, les refresh tokens sont hachés SHA-256 sans secret)
JWT_REFRESH_SECRET=openssl_rand_hex_32
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ─── G5 — chiffrement au repos des secrets TOTP (MFA) ──────────────────────
# REQUIS EN PRODUCTION : le démarrage de l'API est REFUSÉ sans clé valide
# (garde config packages/prod-config — le mode « historique » stockage en
# clair est toléré en dev/test uniquement). 32 octets encodés : 64 caractères
# hexadécimaux, ou base64/base64url. Format de rotation : « courante,ancienne »
# — la première scelle, toutes déchiffrent ; retirer l'ancienne une fois les
# lignes rescellées à la courante (rescellage à l'usage).
# Générer : openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# ── Stockage objets (MinIO / S3) ────────────────────────────────────────────
MINIO_ROOT_USER=minio_prod
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG
# Optionnel — miroir d'images (H1) : si le démon Docker n'a pas d'accès anonyme à
# Quay, pointer ici votre miroir. Laisser vide = image par défaut, épinglée par digest.
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_prod
S3_SECRET_KEY=CHANGE_ME_STRONG
S3_BUCKET=creche-media
S3_REGION=us-east-1
S3_URL_EXPIRY_SECONDS=3600
# Backend de stockage des PDF : 'local' (répertoire) ou 's3' (MinIO/S3)
# H2i: choix explicite identique API/worker. Vide/faute => démarrage refusé.
# local concerne PDF/exports, pas tous les médias (signature toujours S3).
STORAGE_BACKEND=s3
# Si backend local en production : fournir un volume absolu persistant partagé,
# différent de ce défaut de développement (sinon démarrage refusé).
STORAGE_LOCAL_DIR=/tmp/creche-pdf

# ── Webhook de paiement ─────────────────────────────────────────────────────
PAYMENT_WEBHOOK_SECRET=openssl_rand_hex_32

# ── Push (FCM + APNs) ───────────────────────────────────────────────────────
# Contenu JSON du service account Firebase (une ligne, échappé) :
FIREBASE_SERVICE_ACCOUNT_JSON={ "type": "service_account", ... }
APNS_KEY_ID=KEY_ID_APPLE
APNS_TEAM_ID=TEAM_ID_APPLE
APNS_BUNDLE_ID=dz.creche.parent
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...
APNS_PRODUCTION=false

# ── SMS (OTP) ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM=+213xxxxxxxx

# ── WhatsApp Business (notifications + OTP — API Graph Meta) ────────────────
# Requis si les flags whatsapp_notifications / whatsapp_otp sont activés ;
# sans ces valeurs l'API répond 503 WHATSAPP_NOT_CONFIGURED (jamais de faux
# « envoyé »).
WHATSAPP_TOKEN=EAAGxxxxxxxx
WHATSAPP_PHONE_ID=000000000000000
WHATSAPP_API_URL=https://graph.facebook.com/v19.0

# ── Paiement en ligne CIB/Edahabia (SATIM) ──────────────────────────────────
# Requis si le flag online_payment est activé ; sans ces valeurs l'initiation
# répond 503 PAYMENT_NOT_CONFIGURED.
SATIM_MERCHANT_ID=000000000
SATIM_SECRET=CHANGE_ME_STRONG
SATIM_GATEWAY_URL=https://test.satim.dz/payment/rest

# ── Email transactionnel (invitations, reçus) ──────────────────────────────
# P0 (audit continu 2026-09) : EMAIL_PROVIDER=smtp livre réellement via le
# relais indiqué. Sans SMTP_HOST/SMTP_FROM, POST /invitations répond 503
# INVITATION_DELIVERY_UNAVAILABLE avant toute écriture (fail-closed).
# EMAIL_PROVIDER=none : remise dev uniquement, INTERDIT hors development.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.dz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dpo@creche.dz
SMTP_PASS=CHANGE_ME
SMTP_FROM=Creche DZ <no-reply@creche.dz>
SMTP_TO=dpo@creche.dz

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
APP_PORT=3000
APP_URL=https://creche.dz
CORS_ORIGINS=https://creche.dz
# Désactiver le rate limiting applicatif : uniquement en test (jamais en prod)
RATE_LIMIT_DISABLED=false

# ── Rétention / jobs ────────────────────────────────────────────────────────
RETENTION_DAYS=1825
# L4 (décision D2, 2026-09-25) — rétention de la messagerie, appliquée par le
# même job `retention_purge` :
#  * NOTIFICATION_RETENTION_DAYS : file de notifications TERMINÉES (sent/failed) ;
#    l'inbox (notification_inbox) reste la voie de lecture durable, elle n'est
#    pas purgée par ce seuil ;
#  * MESSAGES_RETENTION_DAYS : au-delà, le CONTENU des messages expire (corps
#    remplacé par un marqueur partagé, pièce jointe détachée) — la ligne et ses
#    métadonnées restent.
NOTIFICATION_RETENTION_DAYS=90
MESSAGES_RETENTION_DAYS=365
# E1 : heartbeat < timeout / 3. Jobs repris si aucun heartbeat pendant 15 min.
WORKER_JOB_TIMEOUT_MS=900000
WORKER_HEARTBEAT_MS=30000
WORKER_REAPER_INTERVAL_MS=300000
# Arrêt borné à 45 s dans Compose ; stop_grace_period = 60 s.

# E2–E6 : mensuelle automatique OFF en SQL ; 3 tâches planifiées seulement.
WORKER_SCHEDULER_ENABLED=true
WORKER_SCHEDULER_POLL_MS=60000
WORKER_EXPORT_TIMEOUT_MS=120000
WORKER_EXPORT_MAX_AGE_MS=1800000

# ── Observabilité ───────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxxxxx@oXXXX.ingest.sentry.io/XXXX

# ── Déploiement ─────────────────────────────────────────────────────────────
DOMAIN=creche.dz
VERSION=staging
# Chiffrement des sauvegardes (scripts/backup.sh — GPG symétrique AES256)
BACKUP_PASSPHRASE=CHANGE_ME_STRONG

# ── Alertes d'exploitation E2 (aucune donnée d'enfant) ───────────────────────
# Secret aléatoire en FICHIER hors Git, mode 0400, propriétaire 65534:65534.
ALERT_WEBHOOK_TOKEN_FILE=/etc/creche/secrets/alert-webhook-token
# Choix client : local + e-mail + SMS + WhatsApp. 'local' pour une validation
# sans envoi externe seulement ; toute config incomplète d'un canal actif bloque.
ALERT_CHANNELS=local,email,sms,whatsapp
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURE=false
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_TWILIO_ACCOUNT_SID=
ALERT_TWILIO_AUTH_TOKEN=
ALERT_SMS_FROM=
ALERT_SMS_TO=
ALERT_WHATSAPP_FROM=
ALERT_WHATSAPP_TO=
# Twilio Content SID HX… d'un modèle proactif APPROUVÉ, variables 1/2/3.
ALERT_WHATSAPP_CONTENT_SID=


# ─── H2k — collecte Prometheus de /api/v1/metrics (privilège limité) ────────
# Côté API : UNIQUEMENT la liste des digests SHA-256 des tokens autorisés au
# scrape (virgule = fenêtre de grâce pendant une rotation). Vide = collecte par
# token désactivée ; l'accès administrateur plateforme (H2j) reste le seul
# chemin, l'accès anonyme reste 401. Ne jamais coller le token brut ici.
METRICS_COLLECTOR_TOKEN_HASHES=
# Côté Prometheus : chemin HORS DÉPÔT du fichier contenant le token brut
# (authorization.credentials_file). Générer les deux avec :
#   node scripts/provision-metrics-collector.mjs --out-file /etc/creche/secrets/metrics-collector-token
# (même convention de chemin que ALERT_WEBHOOK_TOKEN_FILE ci-dessus).
METRICS_COLLECTOR_TOKEN_FILE=/etc/creche/secrets/metrics-collector-token

# lib/pq (exporter) requiert TLS par défaut, contrairement à node-pg.
# disable UNIQUEMENT pour le réseau Docker privé du Compose sans TLS PostgreSQL.
# Pour PostgreSQL distant : verify-full et certificats/URL adaptés obligatoires.
MONITORING_PGSSLMODE=disable

# ─── R7 — allowlist /support/ (console support) ──────────────────────────
# Liste de CIDR (séparés par espaces ou virgules) autorisés à atteindre
# /support/ sur nginx. Vide = seuls 127.0.0.1/32 et 10.0.0.0/8 (Docker
# interne) restent autorisés — la console support n'est PAS accessible
# depuis Internet public par défaut. Pour un accès opérateur distant :
#   - SOIT passer par le VPN WireGuard et n'ajouter que le CIDR du VPN
#     (ex. 10.8.0.0/24),
#   - SOIT ajouter l'IP publique statique de l'opérateur (ex. 192.0.2.10/32).
# Une rotation de cette liste impose un restart de nginx (la map `geo` n'est
# pas hot-reloadable). Logs des accès dans nginx access_log.
SUPPORT_ALLOWED_CIDRS=
